{
  "name": "desafio-helpdesk",
  "version": "1.0.0",
  "description": "Sistema de Gerenciamento de Chamados",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch --env-file .env src/server.ts",
    "seed": "ts-node-dev prisma/seed.ts",
    "test:dev": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watchAll",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "build": "tsup src/ --out-dir build --clean",
    "start": "node build/server.js"
  },
  "prisma": {
    "seed": "npx ts-node-dev prisma/seed.ts"
  },
  "author": "Chandilene",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.12",
    "@types/supertest": "^7.2.0",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.7",
    "prisma": "^5.10.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
